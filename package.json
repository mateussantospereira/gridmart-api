{
  "name": "gridmart-api",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply gridmart-db --local",
    "db:seed": "wrangler d1 execute gridmart-db --local --file=./db/seed.sql",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.123.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@hono/zod-validator": "^0.9.0",
    "@scalar/hono-api-reference": "^0.11.14",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.2",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  }
}
